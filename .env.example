# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transcendence
DATABASE_URL=postgresql://postgres:postgres@db:5432/transcendence

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Nginx / HTTPS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/localhost.crt
SSL_KEY_PATH=/etc/nginx/ssl/localhost.key

# JWT
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=change_me_in_production

# 42 OAuth Configuration
# Register your app at: https://profile.intra.42.fr/oauth/applications
# Set the redirect URI to: https://localhost/api/auth/42/callback
FT_CLIENT_ID=your_42_client_id
FT_CLIENT_SECRET=your_42_client_secret
FT_CALLBACK_URL=https://localhost/api/auth/42/callback
